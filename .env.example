# Docker Compose host ports
FRONTEND_PORT=5173
BACKEND_PORT=8081

# Set this to the URL that participants can open (for example, http://192.168.0.10:5173).
TTF_FRONTEND_BASE_URL=http://localhost:5173
TTF_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Keep false for local HTTP. Set true when the frontend is served over HTTPS.
TTF_COOKIE_SECURE=false
